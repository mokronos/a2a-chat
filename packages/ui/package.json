{
  "name": "@mokronos/a2a-chat-ui",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokronos/a2a-chat.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/mokronos/a2a-chat#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./forms": {
      "types": "./dist/forms.d.ts",
      "import": "./dist/forms.js"
    },
    "./inspector": {
      "types": "./dist/inspector.d.ts",
      "import": "./dist/inspector.js"
    },
    "./rich-markdown": {
      "types": "./dist/rich-markdown.d.ts",
      "import": "./dist/rich-markdown.js"
    }
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup src/index.ts src/forms.ts src/inspector.ts src/rich-markdown.tsx --format esm --dts --clean && tailwindcss -i ./src/styles/globals.css -o ./dist/styles.css --minify",
    "build:js": "tsup src/index.ts --format esm --clean",
    "watch": "tsup src/index.ts --format esm --watch",
    "dev:js": "tsup src/index.ts --format esm --dts --watch",
    "dev:css": "tailwindcss -i ./src/styles/globals.css -o ./dist/styles.css --watch",
    "dev": "bun run dev:js & bun run dev:css & wait",
    "typecheck": "tsc --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "@mokronos/a2a-react": "^0.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@mokronos/a2a-react": "0.4.0",
    "@tailwindcss/cli": "^4.1.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  }
}
