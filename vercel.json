{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "NODE_ENV=development bun install --frozen-lockfile",
  "buildCommand": "NODE_ENV=production bun run --cwd apps/server build:web",
  "outputDirectory": "apps/server/public",
  "functions": {
    "api/a2a/[...route].ts": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
